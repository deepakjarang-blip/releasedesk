<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Download Portal | ReleaseDesk</title>
  <link rel="stylesheet" href="/assets/tailwind.css">
</head>
<body class="min-h-screen bg-gray-50 text-gray-900">
  <header class="border-b border-gray-200 bg-white">
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5">
      <a href="/" class="text-lg font-semibold tracking-tight">ReleaseDesk</a>
      <span class="text-sm text-gray-500">Download Portal</span>
    </div>
  </header>
  <main class="mx-auto max-w-5xl px-6 py-12">
    <div class="mb-8 border-b border-gray-200 pb-5">
      <p class="text-sm font-medium uppercase text-violet-800">Applications</p>
      <h1 class="mt-2 text-3xl font-semibold">Available downloads</h1>
    </div>
    {{if .Apps}}
      <ul class="divide-y divide-gray-200 border-y border-gray-200">
        {{range .Apps}}
          <li>
            <a href="/{{.Slug}}" class="block py-6 hover:bg-white">
              <h2 class="text-lg font-semibold">{{.Name}}</h2>
              {{if .Description.Valid}}<p class="mt-1 max-w-2xl text-sm text-gray-600">{{.Description.String}}</p>{{end}}
              <span class="mt-3 inline-block text-sm font-medium text-violet-800">View releases &rarr;</span>
            </a>
          </li>
        {{end}}
      </ul>
    {{else}}
      <p class="border-y border-gray-200 py-8 text-sm text-gray-600">No public applications are available yet.</p>
    {{end}}
  </main>
</body>
</html>